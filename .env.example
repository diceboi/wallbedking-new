# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Amazon Selling Partner API (SP-API) Configuration
# Documentation: https://developer-docs.amazon.com/sp-api/docs/feeds-api-v2021-06-30-use-case-guide
# Obtain from Amazon Seller Central -> Partner Network -> Develop Apps
AMAZON_SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_SP_API_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_SP_API_REFRESH_TOKEN=Atzr|IwEBIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_SELLER_ID=AXXXXXXXXXXXXX
AMAZON_SP_API_REGION=eu

# PayPal Configuration (Separated for UK and International)
# Obtain from PayPal Developer Dashboard -> Apps & Credentials -> Live
NEXT_PUBLIC_PAYPAL_CLIENT_ID_UK=your_paypal_uk_live_client_id_here
PAYPAL_CLIENT_SECRET_UK=your_paypal_uk_live_secret_here
PAYPAL_WEBHOOK_ID_UK=your_paypal_uk_webhook_id_here

NEXT_PUBLIC_PAYPAL_CLIENT_ID_INTL=your_paypal_intl_live_client_id_here
PAYPAL_CLIENT_SECRET_INTL=your_paypal_intl_live_secret_here
PAYPAL_WEBHOOK_ID_INTL=your_paypal_intl_webhook_id_here

# Stripe Configuration (Separated for UK and International)
STRIPE_SECRET_KEY_UK=sk_live_...
STRIPE_WEBHOOK_SECRET_UK=whsec_...

STRIPE_SECRET_KEY_EU=sk_live_...
STRIPE_WEBHOOK_SECRET_EU=whsec_...
