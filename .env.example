# Shopify Storefront API Configuration
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# Public Storefront API Access Token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Private / Admin API Access Token (Server-only)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_access_token
SHOPIFY_PRIVATE_ACCESS_TOKEN=shpat_your_admin_access_token

# Shopify Customer Account API / OAuth Configuration
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_ACCOUNT_ID=your_shopify_account_id

# Customer Authentication Endpoints
NEXT_PUBLIC_SHOPIFY_AUTH_URL=https://shopify.com/authentication/your_account_id/oauth/authorize
SHOPIFY_TOKEN_URL=https://shopify.com/authentication/your_account_id/oauth/token
NEXT_PUBLIC_SHOPIFY_LOGOUT_URL=https://shopify.com/authentication/your_account_id/logout
